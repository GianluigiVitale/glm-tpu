+}
+CANDIDATE_SHA = {
+    "dsa_c131072": "65b230dfd99f872216aa86e5a71e389a4b48aa081eb96f52c638e97a871abf08",
+    "dsa_c262656": "0974712aa5120e37fc7ff4420650647571f62eb4351849bdd37523abdad455a5",
