+"""Existing4096 key tiling against selected512 control; CPU, no TPU speed claim."""
+
+from functools import partial
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+from glm_tpu.greenfield.kernels.prefill_dsa import causal_dsa_local_candidates
+
+
+def test_wide_keys_same_local_score_bits_ties_tails_and_health():
+    # More than two4096 tiles, disjoint striped positions with holes, and rows
+    # on both sides of a competitive top2048 boundary. No altered scorer.
+    rng = np.random.default_rng(603)
+    size, rows = 8211, 4
+    query = jnp.asarray(rng.normal(size=(rows, 32, 128)), jnp.float32)
+    keys = jnp.asarray(rng.normal(size=(size, 128)), jnp.bfloat16)
+    weights = jnp.asarray(rng.normal(size=(rows, 32)), jnp.float32).at[-1].set(0)
+    pos = (jnp.arange(size, dtype=jnp.int32) * 8 + 3).at[513].set(-1)
+    lengths = jnp.asarray([0, 4095 * 8, 8193 * 8, size * 8], jnp.int32)
+    fn = partial(
+        causal_dsa_local_candidates,
+        global_context_size=size * 8,
+        top_k=2048,
+        precision="default",
+        paired_position_sort=True,
+        sorted_local_merge=True,
+    )
+    control = jax.jit(partial(fn, key_tile=512))
+    candidate = jax.jit(partial(fn, key_tile=4096))
+
+    def compare(args, healthy):
+        left, right = control(*args), candidate(*args)
+        for a, b in zip(left, right, strict=True):
+            assert np.asarray(a).tobytes() == np.asarray(b).tobytes()
+        assert bool(right.valid) is healthy
+        return right
+
+    args = query, keys, weights, pos, lengths
+    result = compare(args, True)
+    # All equal scores use the lowest live position, not owner/tile order.
+    expected = np.asarray(pos)
+    expected = expected[expected >= 0][:2048]
+    np.testing.assert_array_equal(result.positions[-1], expected)
+    assert np.all(np.asarray(result.positions[0]) == -1)
+    assert np.isneginf(np.asarray(result.scores[0])).all()
+    # A future-only4096 tile must be harmless even when poisoned. A visible
+    # NaN or invalid owner metadata must still fail; no tolerance is widened.
+    compare(
+        (
+            query,
+            keys.at[4096:].set(jnp.nan),
+            weights,
+            pos,
+            jnp.full((rows,), 4096 * 8, jnp.int32),
+        ),
+        True,
+    )
+    for bad in (
+        (query, keys.at[0].set(jnp.nan), weights, pos, lengths),
+        (query, keys, weights, pos.at[2].set(pos[1]), lengths),
+        (query, keys, weights, pos, lengths.at[0].set(-1)),
+    ):
+        # Invalid numerical results need not have equal NaN payloads: health
+        # refusal, rather than invalid-score arithmetic, is the requirement.
+        assert not bool(control(*bad).valid)
+        assert not bool(candidate(*bad).valid)
+
