+capacity,rows,topk=32768,5,2048
+positions=b.stripe_positions(capacity,0,capacity)
+keys=b.key_values(positions)
+lengths=np.asarray([0,17,2048,8193,32768],np.int32)
+specs=(P(),P('expert',None),P(),P('expert'),P())
+programs=[b.build_dsa_program(mesh,capacity=capacity,rows=rows,top_k=topk,
+                            sorted_local_merge=True,key_tile=tile)
+          for tile in (512,4096)]
+for tied in (False,True):
+ q,h=b.query_inputs(rows=rows,tied=tied)
+ args=tuple(jax.device_put(v,NamedSharding(mesh,p))
+            for v,p in zip((q,keys,h,positions,lengths),specs))
+ outputs=[fn(*args) for fn in programs]
+ expected=b.expected_selection(lengths,top_k=topk,tied=tied)
+ for output in outputs:
+  assert b.check_output(output,expected)['passed']
+ for a,c in zip(jax.tree.leaves(outputs[0]),jax.tree.leaves(outputs[1])):
+  assert np.asarray(a).tobytes()==np.asarray(c).tobytes()
+ # Static program contains only the existing expert8 candidate exchange.
+ hlo=str(programs[1].lower(*args).compiler_ir('stablehlo'))
+ assert hlo.count('stablehlo.all_gather')==2
+ assert 'host_transfer' not in hlo and 'callback' not in hlo
+print('WIDE_KEY_CPU32_PASS')
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", code],
+        cwd=Path(__file__).resolve().parents[3],
