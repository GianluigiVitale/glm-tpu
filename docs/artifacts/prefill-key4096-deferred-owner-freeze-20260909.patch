+    "Fixed endpoint<=0.90 and midpoint<=1.05 p50 ratios; early-prefix ratios "
+    "reported, not a blanket short-prefix promotion."
+)
+
+
+class WideKeyJournal(Ws32NumericalJournal):
+    artifact_kind = "greenfield_ws32_prefill_wide_key_journal"
+
+    def _check_identity(self, identity):
+        if (
+            identity.get("protocol") != PROTOCOL
+            or identity.get("profile") != PROFILE
+            or identity.get("compile_only") is not False
+        ):
+            raise ValueError("unregistered wide-key journal identity")
+
+
+def registration() -> dict:
+    for name, digest in BINDINGS.items():
+        path = REPO / name
+        if path.is_symlink() or sha256(path.read_bytes()).hexdigest() != digest:
+            raise ValueError(f"wide-key registration bytes differ: {name}")
+    return dict(
+        protocol=PROTOCOL,
+        profile=PROFILE,
+        bound_files=dict(BINDINGS),
+        baseline_db_run_id=599,
+        baseline_summary_sha256=BASELINE_SUMMARY_SHA,
+        sorted_local_merge=True,
+        key_tile=KEY_TILE,
+        overhead_remeasured=False,
+    )
+
+
+def inspect_program(name: str, stable: str, optimized: str, memory: dict) -> dict:
+    from scripts.greenfield import prefill_budget_worker as baseline
+
+    if (
+        name not in CANDIDATE_SHA
+        or sha256(stable.encode()).hexdigest() != CANDIDATE_SHA[name]
+    ):
+        raise ValueError("wide-key preregistered StableHLO differs")
+    result = baseline.inspect_program(name, stable, optimized, memory)
+    return dict(result, profile=PROFILE, sorted_local_merge=True, key_tile=KEY_TILE)
+
+
+def baseline_wall() -> dict:
+    from scripts.greenfield import prefill_budget_evidence as evidence
+
+    registration()
+    path = Path("/home/gianl/glm-run") / BASELINE_TAG / "summary.json"
+    raw = path.read_bytes()
+    if path.is_symlink() or sha256(raw).hexdigest() != BASELINE_SUMMARY_SHA:
+        raise ValueError("wide-key retained DB599 summary differs")
+    summary = json.loads(raw)
+    if summary["results_db_run_id"] != 599:
+        raise ValueError("wide-key baseline DB identity differs")
+    result = evidence.fleet_wall(summary["runner"]["workers"])
+    same_json(result, summary["runner"]["dsa_wall"], "DB599 aligned original samples")
+    return result
+
+
+def compare(actual: dict) -> dict:
+    return retained.compare_wall(
+        actual,
+        baseline_wall(),
+        registration(),
+        baseline_db_run_id=599,
+        baseline_summary_sha256=BASELINE_SUMMARY_SHA,
+    )
