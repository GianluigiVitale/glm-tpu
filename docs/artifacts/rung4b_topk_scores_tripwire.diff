+        monkeypatch.delenv("GLM_DSA_DCP", raising=False)
+    wrappers, kv_caches, index_map = [], [], {}
+    for li in range(_ML_FULL):
+        arrs = _indexer_arrays(seed=110 + li)
+        if zero_w_layer == li:
+            arrs["weights_proj"] = np.zeros_like(arrs["weights_proj"])
