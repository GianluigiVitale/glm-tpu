+                             prefix=f"model.layers.{li}.self_attn",
+                             seed=120 + li)
+        wrappers.append(w)
+        # The RUNNER-REAL registration order: indexer.k_cache BEFORE attn.
+        index_map[f"model.layers.{li}.self_attn.indexer.k_cache"] = len(
+            kv_caches)
+        kv_caches.append(_empty_idx_cache())
+        index_map[f"model.layers.{li}.self_attn.attn"] = len(kv_caches)
+        kv_caches.append(_empty_mla_cache())
