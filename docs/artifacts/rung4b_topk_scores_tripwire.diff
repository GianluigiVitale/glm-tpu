+def _tripwire_mask(sel_rows, kv_lens):
+    """Score-blind tripwire (rung-2 adjudication 2026-07-10): True per row
+    iff the row is EXACTLY ``arange(min(kv_len, width))`` followed by the
+    ``-1`` fill, with ``kv_len > 2``.
+
+    Ascending identity is the byte-exact output of an all-tied/constant
+    score row through the DCP merge (position pre-sort + lowest-index tie
+    break) AND through the gate-off ``hierarchical_topk`` (``lax.top_k``
+    lowest-index tie break) — verified bit-for-bit against the rung-2 metal
+    dumps at pod geometry. A real scored selection hits it with probability
+    ~0 for kv_len > 2; kv_len <= 2 rows are exempt (a 1-2 element causal
+    prefix is legitimately [0(,1)])."""
+    sel_rows = np.asarray(sel_rows)
+    kv = np.asarray(kv_lens).astype(np.int64).reshape(-1)
+    width = sel_rows.shape[1]
+    k = np.minimum(kv, width)[:, None]
+    iota = np.arange(width, dtype=sel_rows.dtype)[None, :]
+    want = np.where(iota < k, iota, sel_rows.dtype.type(-1))
+    return (kv > 2) & (sel_rows == want).all(axis=1)
+
+
