+def test_topk_scores_payload_round_trip(monkeypatch, tmp_path):
+    """rung 4b: a stash that threads ``topk_scores`` (the armed-only
+    selected-slot scores) dumps them alongside the indices — f32, dtype-
+    tagged, bit-exact; a stash WITHOUT them writes no such key (the
+    xla_ref / cache-less stash sites), and the differ treats the payload
+    as optional."""
+    monkeypatch.setenv("GLM_DSA_DUMP_TOPK", str(tmp_path / "s.npz"))
+    pos = jnp.arange(4, dtype=jnp.int32)
+    scores = jnp.asarray(
+        np.linspace(9.0, -3.0, 24, dtype=np.float32).reshape(4, 6))
+    with _ctx():
+        glm_dsa_indexer.stash_topk_indices(_indices(),
+                                           positions=pos,
+                                           topk_scores=scores)
+    with _ctx():
+        glm_dsa_indexer.stash_topk_indices(_indices(), positions=pos)
+    jax.effects_barrier()
+    proc = jax.process_index()
+    d1 = np.load(str(tmp_path / f"s.step0001.evt00.proc{proc}.npz"),
+                 allow_pickle=False)
+    assert d1["topk_scores"].dtype == np.float32
+    assert str(d1["topk_scores__dtype"]) == "float32"
+    np.testing.assert_array_equal(d1["topk_scores"], np.asarray(scores))
+    d2 = np.load(str(tmp_path / f"s.step0002.evt00.proc{proc}.npz"),
