+def test_tripwire_arange_row_fails_even_on_elementwise_match(
+        tmp_path, capsys):
+    """Two runs that AGREE on a score-blind selection must not MATCH: the
+    rung-2 dcp=2 defect (evt00 selecting arange every decode step) would
+    sail through a pure elementwise comparison against an equally broken
+    run — the tripwire is the absolute check."""
+    a, b = str(tmp_path / "a"), str(tmp_path / "b")
+    # Live row 3 at step 1 has position 4 -> kv_len 5 (> 2): poison BOTH
+    # runs identically with arange(5) + the -1 fill.
+    poison = (1, 0, lambda sel: _arange_row(sel, 3, 5))
+    _write_run(a, perturb=poison)
+    _write_run(b, perturb=poison)
+    r = dsa_topk_diff.selection_diff(a, b)
+    assert r["differ"] is True
+    assert r["n_diff_events"] == 0  # elementwise the runs agree...
+    assert r["n_tripwire_rows"] == 2  # ...but BOTH runs are score-blind
+    t = r["tripwire"][0]
+    assert (t["step"], t["event"], t["live_row"], t["kv_len"]) == (1, 0, 3, 5)
+    assert "SCORE-BLIND TRIPWIRE" in r["verdict"]
