+def _row_kth_band(idx_a, sc_a, idx_b, sc_b):
+    """Max distance of a set-difference element's own-run score from that
+    run's k-th (lowest selected) score, over both directions of one aligned
+    row pair. 0.0 when the sets are equal (a pure tie-order diff)."""
+    band = 0.0
+    for idx_x, sc_x, idx_y in ((idx_a, sc_a, idx_b), (idx_b, sc_b, idx_a)):
+        mine = idx_x >= 0
+        if not mine.any():
+            continue
+        kth = float(sc_x[mine].min())
+        other = set(int(v) for v in idx_y[idx_y >= 0])
+        for slot in np.flatnonzero(mine):
+            if int(idx_x[slot]) not in other:
+                band = max(band, float(sc_x[slot]) - kth)
+    return band
+
